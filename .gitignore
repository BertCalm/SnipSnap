build/
.gradle/
local.properties
*.iml
.idea/
.DS_Store
.kotlin/
# Claude Code's per-checkout state stays out of the repo, with three
# exceptions written *for* this repo and shared with everyone working in
# it: .claude/skills/ (the skills), .claude/hooks/ (the SessionStart hook
# that warms the build in a cloud session) and .claude/settings.json (the
# project settings that register it). settings.local.json and the rest
# stay personal. A directory that is excluded is never descended into, so
# the contents have to be excluded rather than the directory itself for
# the negations below to be reachable.
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.superpowers/

# The native build tree of :app (CMake/NDK intermediates).
app/.cxx/

# Seeded design-canvas pages - the ~2 MB editor payload the /design helper
# wraps an artboard set in. The .dc.html boards, canvas.json and support.js
# beside them ARE the design; the seeded page is rebuilt from those and
# lives on the artifact, so it is never committed.
design/*/*.html
!design/*/*.dc.html

# The PLUCK audition clips and page, rendered by :synth:generatePluckAudition
# and published as the listening artifact; never committed.
testkit/pluck-audition/

# The GLINT audition clips and page, rendered by :synth:generateGlintAudition
# and published as the listening artifact; never committed.
testkit/glint-audition/

# The GLINT D1 depth-pass audition clips and page, rendered by
# :synth:generateGlintD1Audition; never committed. The clips land under
# clips/ and the page is copied in as index.html — this pattern still
# covers both since it ignores the whole directory.
testkit/glint-d1-audition/

# The GLINT D2 audition clips and page, rendered by
# :synth:generateGlintD2Audition; never committed. Same layout as D1: clips
# under clips/, the page copied in as index.html.
testkit/glint-d2-audition/

# The TINES audition phrases and page, rendered by :synth:generateTinesAudition
# and published as the listening artifact; never committed.
testkit/tines-audition/
# The SIREN audition clips, manifest and page, rendered by :synth:generateSirenAudition
# and published as the listening artifact; never committed.
testkit/siren-audition/

# The FORK audition clips, manifest and page, rendered by :synth:generateForkAudition
# and published as the listening artifact; never committed.
testkit/fork-audition/
