build/
.gradle/
local.properties
*.iml
.idea/
.DS_Store
.kotlin/
# Claude Code's per-checkout state stays out of the repo, with one
# exception: .claude/skills/ holds skills written *for* this repo and
# shared with everyone working in it. A directory that is excluded is
# never descended into, so the contents have to be excluded rather than
# the directory itself for the negation below to be reachable.
.claude/*
!.claude/skills/
.superpowers/

# The native build tree of :app (CMake/NDK intermediates).
app/.cxx/

# Seeded design-canvas pages - the ~2 MB editor payload the /design helper
# wraps an artboard set in. The .dc.html boards, canvas.json and support.js
# beside them ARE the design; the seeded page is rebuilt from those and
# lives on the artifact, so it is never committed.
design/*/*.html
!design/*/*.dc.html
