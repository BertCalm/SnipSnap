<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capture (M1) landed: MicSessionService below is the armed session. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- INSIDE (M1's second source): AudioPlaybackCapture rides a
         MediaProjection consent, and Android 14+ requires the session's
         foreground service to carry the mediaProjection type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Bubble (Task 5): optional. Granted via
         ACTION_MANAGE_OVERLAY_PERMISSION, offered once from the ARM flow —
         never required, the notification's own SNIP action is the whole
         story when this isn't granted. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".SnipSnapApplication"
        android:label="SnipSnap"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The six-track phasing loop grid (plan-03). No launcher filter:
             one front door. Reachable in dev via
             adb shell am start -n com.snipsnap.app/.LoopActivity -->
        <activity
            android:name=".LoopActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!-- The always-listening ring's foreground session (retroactive-snip
             plan, Task 2). Never exported: only this app's own ARM buttons
             (and its own notification action and tile) ever start it. The
             type is whichever source is armed: microphone for ARM TAPE,
             mediaProjection for ARM INSIDE. -->
        <service
            android:name=".MicSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

        <!-- The quick-settings tile (M1): SNIP while a session is armed,
             opens the app to arm one otherwise. -->
        <service
            android:name=".SnipTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="SnipSnap"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
