<?xml version="1.0" encoding="utf-8"?>
<!-- The SnipSnap symbol: four pads touching at the corners, read as an x.
     Geometry is Mark.symbol(30, 30, 48) on the 108 dp adaptive-icon viewport,
     so the 48 dp mark sits centred in the 66 dp safe zone. LauncherIconTest
     pins these points to Mark, so the icon and the drawn mark cannot drift. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#E08A68"
        android:pathData="M 42.0,30.0 L 54.0,42.0 L 42.0,54.0 L 30.0,42.0 Z" />
    <path
        android:fillColor="#EEEADD"
        android:pathData="M 66.0,30.0 L 78.0,42.0 L 66.0,54.0 L 54.0,42.0 Z" />
    <path
        android:fillColor="#EEEADD"
        android:pathData="M 42.0,54.0 L 54.0,66.0 L 42.0,78.0 L 30.0,66.0 Z" />
    <path
        android:fillColor="#E08A68"
        android:pathData="M 66.0,54.0 L 78.0,66.0 L 66.0,78.0 L 54.0,66.0 Z" />
</vector>
