index 000000000..ad9af390f
--- /dev/null
+++ b/synth/src/test/kotlin/com/snipsnap/synth/LowPassPairTest.kt
@@ -0,0 +1,44 @@
+package com.snipsnap.synth
+
+import kotlin.random.Random
+import kotlin.test.*
+
+class LowPassPairTest {
+    @Test fun `pipelined fresh pairs retain every reference Float bit at buffer boundaries and rate corners`() {
+        val random = Random(174)
+        val inputs = listOf(
+            floatArrayOf(), floatArrayOf(1f), floatArrayOf(-0f), floatArrayOf(1f, -.5f),
+            FloatArray(31) { if (it == 0) 1f else 0f },
+            FloatArray(1025) { random.nextFloat() * 2 - 1 },
+            FloatArray(1025) { if (it % 2 == 0) Float.MIN_VALUE else -Float.MIN_VALUE },
+            floatArrayOf(Float.POSITIVE_INFINITY, 0f, Float.NEGATIVE_INFINITY, Float.NaN),
+            floatArrayOf(Float.MAX_VALUE, -Float.MAX_VALUE, 0f, 1f),
+        )
+        for (rate in listOf(44_100, 176_400, 352_800)) for (hz in listOf(1f, 19_500f, rate.toFloat()))
+            for ((first, second) in listOf(1.9616f to 1.6629f, 1.1111f to .3902f, 0f to .7f))
+                for (input in inputs) {
+                    val expected = input.copyOf()
+                    Dsp.TptSvf(rate).lowPassInPlace(expected, hz, first)
+                    Dsp.TptSvf(rate).lowPassInPlace(expected, hz, second)
+                    val actual = input.copyOf()
+                    Dsp.TptSvf.lowPassPairInPlace(actual, rate, hz, first, second)
+                    for (i in expected.indices) assertEquals(expected[i].toRawBits(), actual[i].toRawBits(),
+                        "pair boundary/rate guard: rate=$rate cutoff=$hz size=${input.size} frame=$i")
+                }
+    }
+
+    @Test fun `eight-pole delivery filter remains exact over a ringing signal and complete tail`() {
+        val input = FloatArray(50_003) { i ->
+            (kotlin.math.sin(i * .072) * kotlin.math.exp(-i / 1900.0)).toFloat()
+        }
+        for (rate in listOf(176_400, 352_800)) {
+            val expected = input.copyOf()
+            for (k in floatArrayOf(1.9616f, 1.6629f, 1.1111f, .3902f))
+                Dsp.TptSvf(rate).lowPassInPlace(expected, Tide.BAND_LIMIT_HZ, k)
+            val actual = input.copyOf()
+            Tide.bandLimit(actual, rate)
+            assertContentEquals(expected.map { it.toRawBits() }, actual.map { it.toRawBits() },
+                "four original poles and output ordering must survive the pair schedule")
+        }
+    }
+}
