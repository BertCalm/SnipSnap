diff --git a/synth/src/main/kotlin/com/snipsnap/synth/Dsp.kt b/synth/src/main/kotlin/com/snipsnap/synth/Dsp.kt
index 195866f5a..063ae9f0f 100644
--- a/synth/src/main/kotlin/com/snipsnap/synth/Dsp.kt
+++ b/synth/src/main/kotlin/com/snipsnap/synth/Dsp.kt
@@ -311,0 +312,50 @@ internal object Dsp {
+        companion object {
+            /** Two fresh linear low-passes with the same arithmetic as two
+             * [lowPassInPlace] passes. The second consumes the previous first-stage
+             * result, so the CPU can advance independent recurrences together.
+             * No pole, rounding order or stored sample changes; no state escapes. */
+            internal fun lowPassPairInPlace(buf: FloatArray, rate: Int, freqHz: Float, firstK: Float, secondK: Float) {
+                if (buf.isEmpty()) return
+                // Diagnostic non-finite values can choose different NaN signs
+                // when independent operations are scheduled together. Preserve
+                // their original path, also leaving enormous non-audio inputs
+                // with the reference's overflow behavior. 1e20 leaves ample
+                // Float headroom for the two stable filters' internal states.
+                if (!freqHz.isFinite() || !firstK.isFinite() || !secondK.isFinite() ||
+                    buf.any { it !in -1e20f..1e20f }) {
+                    TptSvf(rate).lowPassInPlace(buf, freqHz, firstK)
+                    TptSvf(rate).lowPassInPlace(buf, freqHz, secondK)
+                    return
+                }
+                fun coefficients(k: Float): FloatArray {
+                    val g = kotlin.math.tan(PI * (freqHz.coerceIn(10f, rate * 0.49f)) / rate).toFloat()
+                    val kk = k.coerceAtLeast(0.1f)
+                    val a1 = 1f / (1f + g * (g + kk))
+                    val a2 = g * a1
+                    return floatArrayOf(a1, a2, g * a2)
+                }
+                val a = coefficients(firstK); val b = coefficients(secondK)
+                val a1 = a[0]; val a2 = a[1]; val a3 = a[2]
+                val b1 = b[0]; val b2 = b[1]; val b3 = b[2]
+                var s1 = 0f; var s2 = 0f; var t1 = 0f; var t2 = 0f
+                val first = buf[0] - s2
+                val p = a1 * s1 + a2 * first
+                var previous = s2 + a2 * s1 + a3 * first
+                s1 = 2f * p - s1; s2 = 2f * previous - s2
+                for (i in 1 until buf.size) {
+                    val v3 = buf[i] - s2
+                    val w3 = previous - t2
+                    val v1 = a1 * s1 + a2 * v3
+                    val w1 = b1 * t1 + b2 * w3
+                    val v2 = s2 + a2 * s1 + a3 * v3
+                    val w2 = t2 + b2 * t1 + b3 * w3
+                    s1 = 2f * v1 - s1; s2 = 2f * v2 - s2
+                    t1 = 2f * w1 - t1; t2 = 2f * w2 - t2
+                    buf[i - 1] = w2
+                    previous = v2
+                }
+                val w3 = previous - t2
+                buf[buf.lastIndex] = t2 + b2 * t1 + b3 * w3
+            }
+        }
+
