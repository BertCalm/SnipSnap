{
 "version": 1,
 "note": "BOROUGH recipes exported from the Python harness (prototype/borough). Numbers only.",
 "rules": {
  "zones": [
   0.35,
   0.65,
   1.0
  ],
  "takes": 3,
  "level_law": "0.89 * v^0.8",
  "take_jitter": {
   "hz_sd": 0.004,
   "ms_and_t1_sd": 0.04,
   "click_wire_sd": 0.1,
   "click_wire_clip": [
    0.7,
    1.3
   ],
   "note": "take 0 is the recipe itself; takes 1-2 jitter it (build.jitter)"
  },
  "end": "trim at -60 dB of the 10 ms envelope peak; a 250 ms cosine release when the last 10 ms is above 1e-3 of the peak, else 10 ms; peak 1 (acoustic.end)",
  "record_chain": "compress(comp: threshold 24*comp dB under peak, ratio 4, attack 2 ms, release 90 ms) -> tanh drive (d = drive*(0.35+0.65 v), g = 1+10d) -> tilt (1 kHz high-pass blend, dB) -> 2-pole low-pass (acoustic.record)",
  "room": "EMBER room by distance (to44 / ember_voice DISTANCE)",
  "ghost": "designed snare at 0.4 x velocity, 0.35 s",
  "stack_chain": {
   "distance": 0.25,
   "comp": 0.35,
   "drive": 0.15,
   "lp": 14000,
   "tilt": 0
  },
  "stack_trim": "the kit's rest_trim_db, as on its snare and hats",
  "stack_tail": {
   "hold_ms": 30.0,
   "tail_ms": 250.0,
   "long_tail_ms": 600.0,
   "long_labels": [
    "BELL HI",
    "BELL LO",
    "RIDE",
    "RIDE BELL"
   ],
   "note": "after hold_ms an exponential decay reaching -30 dB at the tail (fuller.shorten); cut where it reaches -60 dB with a 10 ms cosine fade"
  },
  "glue": {
   "threshold_dbfs": -10.0,
   "ratio": 4.0,
   "attack_ms": 10.0,
   "release_ms": 120.0,
   "limiter": {
    "lookahead_ms": 3.0,
    "release_ms": 50.0,
    "ceiling_dbfs": -1.0
   },
   "live": "per kit: input trim -> saturation tanh(g x)/tanh(g), g = 10^(saturation_db/20), null for none -> the compressor and limiter above, makeup x limiter drive (glue_recipe.py)"
  }
 },
